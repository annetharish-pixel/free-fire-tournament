# =================================================================
# FREE FIRE TOURNAMENT PORTAL - SMTP / EMAIL CONFIGURATION
# =================================================================
# Copy this file to '.env' or set these environment variables on your hosting server (Render, Railway, Heroku, VPS, etc.).

# SMTP Server Host (e.g. smtp.gmail.com for Gmail, smtp.office365.com for Outlook)
SMTP_SERVER=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Enable TLS (True for port 587, False for port 465 SSL)
SMTP_USE_TLS=true

# Your SMTP Email Address (e.g. your_email@gmail.com)
SMTP_USERNAME=your_email@gmail.com

# Your SMTP Password or Gmail App Password (16-character App Password for Gmail)
# Generate Gmail App Password at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_16_digit_app_password

# Sender Email Address displayed in inbox
SENDER_EMAIL=your_email@gmail.com

# Sender Name displayed in recipient's inbox
SENDER_NAME=Free Fire Squad Battle
